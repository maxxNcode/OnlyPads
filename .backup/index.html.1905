              </tr>
            </thead>
            <tbody id="lbBody">
              <tr><td colspan="9"><div class="empty">Loading Subs…</div></td></tr>
            </tbody>
          </table>
        </div>

        <div class="lbcard__f">
          <span class="dim mono" style="font-size:.72rem" id="lbFoot">—</span>
          <span class="pill pill--amber" id="lbYou" hidden><span class="dot"></span>your wallet is highlighted</span>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ================= TOKEN ================= -->
<section class="sec" id="token">
  <div class="wrap">
    <div class="sec-head rv">
      <div class="eyebrow">The platform token</div>
      <h2 class="h-xl">$ONLY</h2>
      <p class="lead">Every Only launched here sends 5% of its creator reward to the Pad, which buys $ONLY on the open market. Half is burned. The other half drops into the Tip Jar, which Subs claim every 15 minutes.</p>
    </div>

    <div class="token">
      <div class="tokencard rv">
        <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap">
