            <div class="ringwrap__s" id="dropProgress">—</div>
          </div>
        </div>

        <div class="potrow">
          <div>
            <div class="stat__k">In the Tip Jar</div>
            <div class="pot" id="jarPot">—</div>
          </div>
          <div style="text-align:right">
            <div class="stat__k">Buyback split</div>
            <div class="mono" style="font-size:.8rem;color:var(--ink-2);margin-top:8px">50% burn · 50% jar</div>
          </div>
        </div>

        <div class="yourpos" id="yourPos">
          <div class="yourpos__empty" id="yourPosEmpty">
            <div class="yourpos__k">Your position</div>
            <p class="dim" style="font-size:.86rem;margin-top:8px">Connect a Solana wallet to see your sub streak, your weight and what you can claim.</p>
          </div>
          <div id="yourPosBody" hidden>
            <div class="yourpos__k" style="display:flex;align-items:center;gap:8px">
              Your position <span class="lb-w__sim" id="ypSim" hidden>SIMULATED</span>
            </div>
            <div class="prow" style="margin-top:10px"><span class="prow__k">Wallet</span><span class="prow__v" id="ypWallet">—</span></div>
            <div class="prow"><span class="prow__k">$ONLY held</span><span class="prow__v" id="ypBalance">—</span></div>
            <div class="prow"><span class="prow__k">Sub streak</span><span class="prow__v" id="ypHeld">—</span></div>
            <div class="prow"><span class="prow__k">Multiplier</span><span class="prow__v primary" id="ypMult">—</span></div>
            <div class="prow"><span class="prow__k">Weight</span><span class="prow__v secondary" id="ypWeight">—</span></div>
            <div class="prow"><span class="prow__k">Share of the jar</span><span class="prow__v" id="ypShare">—</span></div>
            <div class="prow"><span class="prow__k">Claimable now</span><span class="prow__v amber" id="ypClaimable">—</span></div>
            <div class="prow"><span class="prow__k">Tier</span><span class="prow__v" id="ypTier">—</span></div>
          </div>
        </div>

        <div class="stackrow" id="stackRow" hidden>
          <div class="stackrow__ic">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l9 5-9 5-9-5 9-5z"/><path d="M3 13l9 5 9-5"/></svg>
          </div>
          <div>
            <div class="stackrow__t" id="stackTitle">—</div>
            <div class="stackrow__d" id="stackDesc">—</div>
          </div>
        </div>

        <button class="btn btn--primary btn--full btn--lg" id="claimJarBtn" type="button" disabled>Connect wallet to claim</button>
        <div class="field__h" style="text-align:center" id="claimHint">Drops are 15 minutes long. Unclaimed Drops stack.</div>
        <div style="text-align:center;margin-top:8px">
          <button class="btnlink" id="skipDrop" type="button" style="font-size:.72rem;color:var(--ink-4)">demo · skip to the next Drop →</button>
        </div>

        <div class="epochbar">
          <div class="epochbar__l"><span class="stat__k" id="jarOpenCount">—</span></div>
          <div class="epochbar__dots" id="dropDots"></div>
        </div>
      </div>

      <div class="lbcard rv">
        <div class="lbcard__h">
          <div>
            <div class="h-md">Sub leaderboard</div>
            <div class="dim mono" style="font-size:.72rem;margin-top:4px" id="lbMeta">—</div>
          </div>
          <div class="chips" id="lbSort">
            <button class="is-on" type="button" data-sort="claimable">Claimable</button>
            <button type="button" data-sort="claimed">Lifetime</button>
            <button type="button" data-sort="streak">Streak</button>
            <button type="button" data-sort="weight">Weight</button>
          </div>
        </div>

        <div class="lbwrap">
          <table class="tbl tbl--lb">
            <thead>
              <tr>
                <th style="width:52px">#</th>
                <th>Wallet</th>
                <th>Tier</th>
                <th>$ONLY held</th>
                <th>Mult.</th>
                <th>Weight</th>
                <th>Sub streak</th>
                <th>Lifetime claimed</th>
